# RAPA GO — Backend STAGING (TRUE ISOLATION)
# Copiar a apps/api/.env en el Node app Hostinger de backend-staging.rapago.cl
# NUNCA usar DATABASE_URL / KLAP / SMTP de producción.
# NUNCA aplicar este archivo al Node app de backend.rapago.cl.
#
# Arquitectura:
#   staging.rapago.cl → https://backend-staging.rapago.cl/api
#   → DB staging (proyecto Supabase separado)
#   → Klap sandbox
#   → SMTP test / sink

NODE_ENV=production
APP_ENV=staging
HOST=0.0.0.0
TRUST_PROXY=1

# Frontend staging aislado
FRONTEND_URL=https://staging.rapago.cl
PUBLIC_WEB_BASE_URL=https://staging.rapago.cl

# CORS: con APP_ENV=staging el código añade https://staging.rapago.cl por defecto.
# Explicitar igual para claridad operacional:
CORS_ORIGIN=https://staging.rapago.cl,http://localhost:5173,http://127.0.0.1:5173

# ─── DB STAGING (proyecto Supabase NUEVO — NO prod) ─────────────────────────
DATABASE_URL=REEMPLAZAR_CON_URL_POSTGRESQL_STAGING_SSL
SUPABASE_URL=https://REEMPLAZAR-STAGING.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_STAGING_SERVICE_ROLE
SUPABASE_JWT_SECRET=REEMPLAZAR_STAGING_JWT_SECRET

JWT_SECRET=REEMPLAZAR_STAGING_JWT_MIN_32_CHARS
BANK_ACCOUNT_ENCRYPTION_KEY=REEMPLAZAR_STAGING_64_HEX

GOOGLE_MAPS_API_KEY=REEMPLAZAR_CLAVE_SERVER_STAGING

# ─── OAuth staging ──────────────────────────────────────────────────────────
FACEBOOK_APP_ID=REEMPLAZAR
FACEBOOK_APP_SECRET=REEMPLAZAR
FACEBOOK_REDIRECT_URI=https://backend-staging.rapago.cl/api/auth/facebook/callback

APPLE_ALLOWED_CLIENT_IDS=cl.rapago.app,REEMPLAZAR_SERVICES_ID_WEB_STAGING
APPLE_REVOCATION_DEFAULT_CLIENT_ID=cl.rapago.app
APPLE_TEAM_ID=REEMPLAZAR
APPLE_KEY_ID=REEMPLAZAR
APPLE_PRIVATE_KEY=REEMPLAZAR
OAUTH_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_STAGING_64_HEX
APPLE_TOKEN_TIMEOUT_MS=8000
APPLE_WEB_CLIENT_ID=REEMPLAZAR_SERVICES_ID_WEB_STAGING
# Return URL Apple → backend staging (NO backend.rapago.cl)
APPLE_WEB_REDIRECT_URI=https://backend-staging.rapago.cl/auth/apple/web/callback
APPLE_WEB_FRONTEND_URL=https://staging.rapago.cl

GOOGLE_WEB_CLIENT_ID=REEMPLAZAR_STAGING.apps.googleusercontent.com
GOOGLE_ALLOWED_CLIENT_IDS=REEMPLAZAR_STAGING.apps.googleusercontent.com

# ─── Payments: Klap SANDBOX only (NO prod ApiKey) ───────────────────────────
PAYMENT_PROVIDER=klap
PAYMENT_WEBHOOK_BASE_URL=https://backend-staging.rapago.cl
MOBILE_APP_DEEP_LINK=rapago://
PLATFORM_COMMISSION_PERCENT=15

KLAP_ENVIRONMENT=sandbox
KLAP_API_KEY=REEMPLAZAR_CON_APIKEY_SANDBOX_NO_PROD
KLAP_SANDBOX_ORDERS_URL=https://api-pasarela-sandbox.mcdesaqa.cl/payment-gateway/v1/orders
KLAP_PRODUCTION_ORDERS_URL=https://api.pasarela.multicaja.cl/payment-gateway/v1/orders
KLAP_ALLOWED_SANDBOX_CHECKOUT_HOSTS=pagos-pasarela-sandbox.mcdesaqa.cl,sandbox.mcdesaqa.cl
KLAP_ALLOWED_PRODUCTION_CHECKOUT_HOSTS=pagos.pasarela.multicaja.cl,www.klap.cl
KLAP_REQUEST_TIMEOUT_MS=10000
KLAP_RETURN_URL=https://staging.rapago.cl/passenger/trips?payment=return
KLAP_CANCEL_URL=https://staging.rapago.cl/passenger/trips?payment=failure_return
KLAP_WEBHOOK_CONFIRM_URL=https://backend-staging.rapago.cl/api/webhooks/klap/confirm
KLAP_WEBHOOK_REJECT_URL=https://backend-staging.rapago.cl/api/webhooks/klap/reject
KLAP_WEBHOOK_VALIDATION_URL=https://backend-staging.rapago.cl/api/webhooks/klap/validate
KLAP_ORDER_EXPIRATION_MINUTES=30
KLAP_DISABLE_WALLETS=true
KLAP_DEFERRED_CAPTURE_ENABLED=true
KLAP_CAPTURE_CONTRACT_CONFIRMED=true
KLAP_CAPTURE_SUCCESS_STATUSES=captured,success,approved
# Discovery REAL desactivado en staging — no cobros de observación
KLAP_CAPTURE_DISCOVERY_MODE=false
KLAP_CAPTURE_DISCOVERY_MAX_AMOUNT_CLP=0
KLAP_SEND_IDEMPOTENCY_HEADER=false
KLAP_MERCHANT_NOTIFICATION_EMAIL=

# Mercado Pago no usar en staging aislado salvo sandbox dedicado
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CHECKOUT_URL_MODE=auto
MERCADOPAGO_TIMEOUT_MS=8000
PRONTOPAGA_TIMEOUT_MS=8000

# ─── Email: SMTP test / sink (NO prod mailbox) ──────────────────────────────
SMTP_HOST=REEMPLAZAR_SMTP_TEST_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REEMPLAZAR_TEST
SMTP_PASSWORD=REEMPLAZAR_TEST
SMTP_FROM_NAME=RAPA GO Staging
SMTP_FROM_EMAIL=noreply-staging@REEMPLAZAR_TEST
PASSWORD_RESET_FRONTEND_URL=https://staging.rapago.cl/restablecer-contrasena
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

RETENTION_PURGE_ENABLED=true
RETENTION_PURGE_INTERVAL_MINUTES=60

WHATSAPP_ENABLED=false

ALLOW_FUTURE_FEATURES_IN_PRODUCTION=false
FEATURE_TOURISM_ENABLED=false
FEATURE_RENTALS_ENABLED=false
FEATURE_EVENTS_ENABLED=false

RIDE_RECEIPTS_ENABLED=true
RIDE_RECEIPTS_EMAIL_ENABLED=true
RIDE_RECEIPTS_MAP_PROVIDER=osm
RIDE_RECEIPTS_BUCKET=ride-receipts-staging
RIDE_RECEIPTS_SUPPORT_EMAIL=staging-support@REEMPLAZAR_TEST
RIDE_RECEIPTS_SUPPORT_PHONE=+56 9 0000 0000
RIDE_RECEIPTS_RETRY_INTERVAL_MINUTES=5

DRIVER_APPROVAL_EMAIL_ENABLED=true
