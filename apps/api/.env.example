# ============================================================
# RAPA GO — API Environment Variables
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA commites el archivo .env con valores reales.
# Este archivo NUNCA debe llegar al cliente mobile.
# ============================================================

# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────
# En development: URLs del servidor Vite (5173 o 5174 si 5173 está ocupado), separadas por coma
# En producción: dominio real de la app (sin trailing slash)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8100

# ── Base de datos — PostgreSQL (proveedor intercambiable) ──
# Supabase:  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Neon:      postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Railway:   postgresql://<user>:<password>@<host>.railway.app:5432/<db>
# Local:     postgresql://postgres:postgres@localhost:5432/rapago
DATABASE_URL=

# ── Autenticación JWT ──────────────────────────────────────
# Genera con: openssl rand -hex 64
# Mínimo recomendado: 64 bytes aleatorios
JWT_SECRET=

# ── Google Maps (fases futuras) ────────────────────────────
# Clave server-side sin restricción de origen HTTP
GOOGLE_MAPS_API_KEY=

# ── Pagos ProntoPaga ───────────────────────────────────────
# environment: sandbox | production
PRONTOPAGA_ENVIRONMENT=sandbox
PRONTOPAGA_API_KEY=
PRONTOPAGA_SECRET_KEY=
PRONTOPAGA_COMMERCE_ID=
# URLs base de la API (se pueden omitir para usar los defaults)
PRONTOPAGA_API_URL_SANDBOX=https://sandbox.prontopaga.cl/v1
PRONTOPAGA_API_URL_PROD=https://api.prontopaga.cl/v1

# ── Pagos Flow (fases futuras) ─────────────────────────────
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENVIRONMENT=sandbox

# ── Pagos Transbank (fases futuras) ───────────────────────
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=integration

# ── Pagos MercadoPago (fases futuras) ─────────────────────
MERCADOPAGO_ACCESS_TOKEN=

# ── Plataforma ─────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=15
MOBILE_APP_DEEP_LINK=rapago://
PAYMENT_WEBHOOK_BASE_URL=

# ── WhatsApp Business Cloud API (Meta) ────────────────────
# Mantener en false hasta tener credenciales Meta verificadas.
# Con WHATSAPP_ENABLED=true, las variables marcadas * son obligatorias.
# Genera WHATSAPP_VERIFY_TOKEN con: openssl rand -hex 32
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
