# RAPA GO Ã¢â‚¬â€ API (ejemplo seguro)
# Hostinger aloja/ejecuta el backend. Supabase proporciona PostgreSQL y servicios de datos.
# Nunca guardes secretos reales en GitHub.

NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=1

# Frontend web actualmente publicado en Hostinger.
FRONTEND_URL=https://api.rapago.cl
PUBLIC_WEB_BASE_URL=https://api.rapago.cl

# Se permiten producciÃƒÂ³n, Vite local y pruebas por 127.0.0.1.
# Puedes agregar mÃƒÂ¡s orÃƒÂ­genes separados por coma.
CORS_ORIGIN=https://api.rapago.cl,http://localhost:5173,http://127.0.0.1:5173

# Supabase/PostgreSQL. Usa la URL de conexiÃƒÂ³n PostgreSQL SSL entregada por Supabase.
DATABASE_URL=REEMPLAZAR_CON_URL_POSTGRESQL_DE_SUPABASE_SSL
SUPABASE_URL=https://REEMPLAZAR.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REEMPLAZAR_CON_JWT_SECRET_DE_SUPABASE

# MÃƒÂ­nimo 32 caracteres aleatorios.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_ALEATORIO

# Clave dedicada para cifrar nÃƒÂºmeros de cuentas bancarias.
BANK_ACCOUNT_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEX

# Clave de servidor para el mapa del comprobante PDF (Maps Static API) y, si
# hace falta, Directions. Debe permitir llamadas de servidor: no restringirla
# solo por referente HTTP del frontend. Si Static Maps falla, el PDF usa teselas
# OpenStreetMap de Rapa Nui con la ruta y los marcadores.
GOOGLE_MAPS_API_KEY=REEMPLAZAR_CON_CLAVE_GOOGLE_MAPS

FACEBOOK_APP_ID=REEMPLAZAR_CON_APP_ID
FACEBOOK_APP_SECRET=REEMPLAZAR_CON_APP_SECRET
FACEBOOK_REDIRECT_URI=https://backend.rapago.cl/api/auth/facebook/callback

# Sign in with Apple.
APPLE_ALLOWED_CLIENT_IDS=cl.rapago.app
# Para identidades antiguas sin client_id almacenado. Debe ser uno de los IDs permitidos.
APPLE_REVOCATION_DEFAULT_CLIENT_ID=cl.rapago.app
APPLE_TEAM_ID=REEMPLAZAR_CON_TEAM_ID
APPLE_KEY_ID=REEMPLAZAR_CON_KEY_ID
APPLE_PRIVATE_KEY=REEMPLAZAR_CON_CLAVE_PRIVADA_PKCS8
OAUTH_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEX
# Timeout (ms) para el intercambio y revocaciÃƒÂ³n de tokens con Apple. Opcional Ã¢â‚¬â€ fallback 8000ms.
APPLE_TOKEN_TIMEOUT_MS=8000

# Purga automÃƒÂ¡tica de ubicaciÃƒÂ³n y credenciales efÃƒÂ­meras.
RETENTION_PURGE_ENABLED=true
RETENTION_PURGE_INTERVAL_MINUTES=60

PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ENVIRONMENT=production
MERCADOPAGO_ACCESS_TOKEN=REEMPLAZAR_CON_ACCESS_TOKEN
MERCADOPAGO_PUBLIC_KEY=REEMPLAZAR_CON_PUBLIC_KEY
MERCADOPAGO_CLIENT_ID=REEMPLAZAR_CON_CLIENT_ID
MERCADOPAGO_CLIENT_SECRET=REEMPLAZAR_CON_CLIENT_SECRET
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR_CON_WEBHOOK_SECRET
MERCADOPAGO_CHECKOUT_URL_MODE=auto
# Timeout (ms) para llamadas a la API de Mercado Pago. Opcional Ã¢â‚¬â€ fallback 8000ms.
MERCADOPAGO_TIMEOUT_MS=8000
# Timeout (ms) para llamadas a la API de ProntoPaga. Opcional Ã¢â‚¬â€ fallback 8000ms.
PRONTOPAGA_TIMEOUT_MS=8000

PLATFORM_COMMISSION_PERCENT=15
MOBILE_APP_DEEP_LINK=rapago://
PAYMENT_WEBHOOK_BASE_URL=https://backend.rapago.cl

# Klap Checkout Transparente / PRODUCCION
# La ApiKey real NUNCA debe quedar en Git. Si una clave fue expuesta, rotarla
# antes de cualquier transaccion real.
KLAP_ENVIRONMENT=production
KLAP_API_KEY=REEMPLAZAR_CON_APIKEY_PRODUCCION_ROTADA
KLAP_SANDBOX_ORDERS_URL=https://api-pasarela-sandbox.mcdesaqa.cl/payment-gateway/v1/orders
KLAP_PRODUCTION_ORDERS_URL=https://api.pasarela.multicaja.cl/payment-gateway/v1/orders
KLAP_ALLOWED_SANDBOX_CHECKOUT_HOSTS=pagos-pasarela-sandbox.mcdesaqa.cl,sandbox.mcdesaqa.cl
KLAP_ALLOWED_PRODUCTION_CHECKOUT_HOSTS=pagos.pasarela.multicaja.cl,www.klap.cl
KLAP_REQUEST_TIMEOUT_MS=10000
KLAP_RETURN_URL=https://api.rapago.cl/passenger/trips?payment=return
KLAP_CANCEL_URL=https://api.rapago.cl/passenger/trips?payment=failure_return
KLAP_WEBHOOK_CONFIRM_URL=https://backend.rapago.cl/api/webhooks/klap/confirm
KLAP_WEBHOOK_REJECT_URL=https://backend.rapago.cl/api/webhooks/klap/reject
KLAP_WEBHOOK_VALIDATION_URL=https://backend.rapago.cl/api/webhooks/klap/validate
KLAP_ORDER_EXPIRATION_MINUTES=30
# RAPA GO usa solo tarjeta Klap. Oculta Apple Pay / Google Pay en Checkout.
KLAP_DISABLE_WALLETS=true

# CAPTURA DIFERIDA / AUTHORIZATION (obligatorio en RAPA GO)
# El checkout debe retener el 100% de la tarifa. Nunca una venta inmediata.
# Hostinger debe tener estos valores; si quedan en false, Klap cobra al pagar.
KLAP_DEFERRED_CAPTURE_ENABLED=true

# Activar cuando el comercio Klap acepte POST /orders/{id}/capture.
# Sin esto el viaje se completa pero el cobro queda pendiente de captura.
KLAP_CAPTURE_CONTRACT_CONFIRMED=true
KLAP_CAPTURE_SUCCESS_STATUSES=captured,success,approved

# V3 PRODUCCION - OBSERVACION CONTROLADA
# Permite una captura REAL de un viaje completado para observar HTTP/status/body
# sanitizado. La respuesta se guarda como capture_unknown y NUNCA como success.
# Solo permite captura TOTAL igual al monto autorizado. No admite captura parcial,
# cancelacion con multa ni NO SHOW mientras discovery este activo.
KLAP_CAPTURE_DISCOVERY_MODE=false
# Cuando discovery=true debe ser un entero >= 50 y cubrir SOLO el monto de la
# prueba real autorizada. Mantener 0 mientras discovery=false.
KLAP_CAPTURE_DISCOVERY_MAX_AMOUNT_CLP=0

# Header no confirmado por el contrato Checkout entregado. No enviarlo.
KLAP_SEND_IDEMPOTENCY_HEADER=false

# Correo del comercio para el custom notify_payment_email_merchant
# (comprobante de pago Klap al pasajero/comercio, confirmado por Klap para
# POST /payment-gateway/v1/orders). Opcional: si se deja vacío, la orden se
# crea igual sin los customs de notificación al comercio (notify_payment_merchant
# / notify_payment_email_merchant) — nunca bloquea la creación de la orden.
# No usar un correo por defecto/hardcodeado; dejar vacío hasta confirmar el
# correo real del comercio.
KLAP_MERCHANT_NOTIFICATION_EMAIL=

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_PHONE_NUMBER_ID=REEMPLAZAR
WHATSAPP_BUSINESS_ACCOUNT_ID=REEMPLAZAR
WHATSAPP_ACCESS_TOKEN=REEMPLAZAR
WHATSAPP_APP_SECRET=REEMPLAZAR
WHATSAPP_VERIFY_TOKEN=REEMPLAZAR
WHATSAPP_API_VERSION=v22.0

SMTP_HOST=REEMPLAZAR_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REEMPLAZAR
SMTP_PASSWORD=REEMPLAZAR
SMTP_FROM_NAME=RAPA GO
SMTP_FROM_EMAIL=REEMPLAZAR_CORREO_SOPORTE
PASSWORD_RESET_FRONTEND_URL=https://api.rapago.cl/restablecer-contrasena
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

ALLOW_FUTURE_FEATURES_IN_PRODUCTION=false
FEATURE_TOURISM_ENABLED=false
FEATURE_RENTALS_ENABLED=false
FEATURE_EVENTS_ENABLED=false
GOOGLE_WEB_CLIENT_ID=235001725437-vrlbsljvd7dualqoer59fl94d7qugciu.apps.googleusercontent.com
GOOGLE_ALLOWED_CLIENT_IDS=235001725437-vrlbsljvd7dualqoer59fl94d7qugciu.apps.googleusercontent.com

# Comprobantes PDF automáticos de viajes y cargos.
RIDE_RECEIPTS_ENABLED=true
RIDE_RECEIPTS_EMAIL_ENABLED=true
# google = Static Maps + respaldo OSM. osm = solo OpenStreetMap. sketch = trazado local (pruebas).
RIDE_RECEIPTS_MAP_PROVIDER=google
RIDE_RECEIPTS_BUCKET=ride-receipts
RIDE_RECEIPTS_SUPPORT_EMAIL=soporte@rapago.cl
RIDE_RECEIPTS_SUPPORT_PHONE=+56 9 4796 4171
RIDE_RECEIPTS_RETRY_INTERVAL_MINUTES=5

# Correo automático cuando el administrador habilita al conductor.
DRIVER_APPROVAL_EMAIL_ENABLED=true
