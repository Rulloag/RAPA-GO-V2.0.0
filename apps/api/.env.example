# RAPA GO — API (ejemplo seguro)
# Hostinger aloja/ejecuta el backend. Supabase proporciona PostgreSQL y servicios de datos.
# Nunca guardes secretos reales en GitHub.

NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=1

# Frontend web actualmente publicado en Hostinger.
FRONTEND_URL=https://api.rapago.cl
PUBLIC_WEB_BASE_URL=https://api.rapago.cl

# Se permiten producción, Vite local y pruebas por 127.0.0.1.
# Puedes agregar más orígenes separados por coma.
CORS_ORIGIN=https://api.rapago.cl,http://localhost:5173,http://127.0.0.1:5173

# Supabase/PostgreSQL. Usa la URL de conexión PostgreSQL SSL entregada por Supabase.
DATABASE_URL=REEMPLAZAR_CON_URL_POSTGRESQL_DE_SUPABASE_SSL
SUPABASE_URL=https://REEMPLAZAR.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REEMPLAZAR_CON_JWT_SECRET_DE_SUPABASE

# Mínimo 32 caracteres aleatorios.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_ALEATORIO

# Clave dedicada para cifrar números de cuentas bancarias.
BANK_ACCOUNT_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEX

GOOGLE_MAPS_API_KEY=REEMPLAZAR_CON_CLAVE_GOOGLE_MAPS

FACEBOOK_APP_ID=REEMPLAZAR_CON_APP_ID
FACEBOOK_APP_SECRET=REEMPLAZAR_CON_APP_SECRET
FACEBOOK_REDIRECT_URI=https://backend.rapago.cl/api/auth/facebook/callback

# Sign in with Apple.
APPLE_ALLOWED_CLIENT_IDS=cl.rapago.app
# Para identidades antiguas sin client_id almacenado. Debe ser uno de los IDs permitidos.
APPLE_REVOCATION_DEFAULT_CLIENT_ID=cl.rapago.app
APPLE_TEAM_ID=REEMPLAZAR_CON_TEAM_ID
APPLE_KEY_ID=REEMPLAZAR_CON_KEY_ID
APPLE_PRIVATE_KEY=REEMPLAZAR_CON_CLAVE_PRIVADA_PKCS8
OAUTH_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEX

# Purga automática de ubicación y credenciales efímeras.
RETENTION_PURGE_ENABLED=true
RETENTION_PURGE_INTERVAL_MINUTES=60

PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ENVIRONMENT=production
MERCADOPAGO_ACCESS_TOKEN=REEMPLAZAR_CON_ACCESS_TOKEN
MERCADOPAGO_PUBLIC_KEY=REEMPLAZAR_CON_PUBLIC_KEY
MERCADOPAGO_CLIENT_ID=REEMPLAZAR_CON_CLIENT_ID
MERCADOPAGO_CLIENT_SECRET=REEMPLAZAR_CON_CLIENT_SECRET
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR_CON_WEBHOOK_SECRET
MERCADOPAGO_CHECKOUT_URL_MODE=auto

PLATFORM_COMMISSION_PERCENT=15
MOBILE_APP_DEEP_LINK=rapago://
PAYMENT_WEBHOOK_BASE_URL=https://backend.rapago.cl

# Klap Checkout Transparente — NO registrado todavía como PAYMENT_PROVIDER activo.
# Solo Sandbox está implementado (Fase B). KlapProvider se niega a operar si
# KLAP_ENVIRONMENT != "sandbox". Producción requiere una fase posterior + certificación.
KLAP_ENVIRONMENT=sandbox
KLAP_API_KEY=REEMPLAZAR_CON_APIKEY_SANDBOX
KLAP_SANDBOX_ORDERS_URL=https://api-pasarela-sandbox.mcdesaqa.cl/payment-gateway/v1/orders
KLAP_PRODUCTION_ORDERS_URL=https://api.pasarela.multicaja.cl/payment-gateway/v1/orders
KLAP_REQUEST_TIMEOUT_MS=10000

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_PHONE_NUMBER_ID=REEMPLAZAR
WHATSAPP_BUSINESS_ACCOUNT_ID=REEMPLAZAR
WHATSAPP_ACCESS_TOKEN=REEMPLAZAR
WHATSAPP_APP_SECRET=REEMPLAZAR
WHATSAPP_VERIFY_TOKEN=REEMPLAZAR
WHATSAPP_API_VERSION=v22.0

SMTP_HOST=REEMPLAZAR_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REEMPLAZAR
SMTP_PASSWORD=REEMPLAZAR
SMTP_FROM_NAME=RAPA GO
SMTP_FROM_EMAIL=REEMPLAZAR_CORREO_SOPORTE
PASSWORD_RESET_FRONTEND_URL=https://api.rapago.cl/restablecer-contrasena
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

ALLOW_FUTURE_FEATURES_IN_PRODUCTION=false
FEATURE_TOURISM_ENABLED=false
FEATURE_RENTALS_ENABLED=false
FEATURE_EVENTS_ENABLED=false
