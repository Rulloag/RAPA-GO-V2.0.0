# ============================================================
# RAPA GO — API Environment Variables
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA commites el archivo .env con valores reales.
# Este archivo NUNCA debe llegar al cliente mobile.
# ============================================================

# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8100

# ── Base de datos — PostgreSQL ─────────────────────────────
# Local con clave postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rapago
#
# Local con clave admin:
# DATABASE_URL=postgresql://postgres:admin@localhost:5432/rapago
#
# Supabase:
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:admin@localhost:5432/rapago

# ── Autenticación JWT ──────────────────────────────────────
# En producción generar con: openssl rand -hex 64
JWT_SECRET=rapago_2026_dev_secret_cambiar_en_produccion_123456789_abcdef_987654321

# ── Google Maps ────────────────────────────────────────────
# IMPORTANTE:
# Esta clave quedó expuesta en el chat. Regenera una nueva en Google Cloud.
# Para backend usa una clave server-side.
GOOGLE_MAPS_API_KEY=AIzaSyDZvqVcZBGFPbdHYPM4sYZuIvejDm1ZaOc

# ── Proveedor de pagos activo ──────────────────────────────
# Valores: mercadopago | prontopaga | transbank
PAYMENT_PROVIDER=mercadopago

# ── Pagos MercadoPago ACTIVO ───────────────────────────────
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Pagos ProntoPaga DESACTIVADO ───────────────────────────
PRONTOPAGA_ENVIRONMENT=sandbox
PRONTOPAGA_API_KEY=
PRONTOPAGA_SECRET_KEY=
PRONTOPAGA_COMMERCE_ID=
PRONTOPAGA_API_URL_SANDBOX=https://sandbox.prontopaga.cl/v1
PRONTOPAGA_API_URL_PROD=https://api.prontopaga.cl/v1

# ── Pagos Transbank FUTURO ─────────────────────────────────
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=integration

# ── Pagos Flow FUTURO ──────────────────────────────────────
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENVIRONMENT=sandbox

# ── Plataforma ─────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=15
MOBILE_APP_DEEP_LINK=rapago://
PAYMENT_WEBHOOK_BASE_URL=http://localhost:3000

# ── WhatsApp Business Cloud API FUTURO ─────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0