# ============================================================
# RAPA GO — API Environment Variables
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA commites el archivo .env con valores reales.
# Este archivo NUNCA debe llegar al cliente mobile.
# ============================================================

# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos — PostgreSQL administrado (proveedor intercambiable)
# Supabase:  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Neon:      postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Railway:   postgresql://<user>:<password>@<host>.railway.app:5432/<db>
# AWS RDS:   postgresql://<user>:<password>@<endpoint>:5432/<db>
# GCP SQL:   postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=

# Supabase — service_role_key: SOLO en backend, NUNCA en cliente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Google Maps — clave server-side (sin restricción de origen HTTP).
GOOGLE_MAPS_API_KEY=

# Pagos — Flow
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENVIRONMENT=sandbox

# Pagos — Transbank
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=integration

# Pagos — MercadoPago
MERCADOPAGO_ACCESS_TOKEN=

# Comisión de plataforma (porcentaje entero, ej: 15 = 15%)
PLATFORM_COMMISSION_PERCENT=15

# JWT propio (si no se usa Supabase Auth como única fuente)
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600

# Deep link de la app mobile (para redirects de pago)
MOBILE_APP_DEEP_LINK=rapago://

# URL pública del backend (para webhooks)
PAYMENT_WEBHOOK_BASE_URL=
