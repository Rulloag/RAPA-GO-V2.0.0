{
  "name": "@rapa-go/api",
  "version": "2.0.0",
  "private": true,
  "description": "RAPA GO — Backend API Fastify + TypeScript",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@supabase/supabase-js": "2.43.4",
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.2",
    "fastify": "4.27.0",
    "jsonwebtoken": "9.0.3",
    "postgres": "3.4.9",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.14.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.15.6",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
