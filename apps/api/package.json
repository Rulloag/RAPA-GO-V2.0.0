{
  "name": "@rapa-go/api",
  "version": "2.0.0",
  "private": true,
  "description": "RAPA GO — Backend API Fastify + TypeScript",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "dev": "tsx watch src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @rapa-go/shared",
    "pretest": "npm run build -w @rapa-go/shared",
    "prebuild": "npm run build -w @rapa-go/shared",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:manual": "tsx scripts/apply-manual-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "migrate:prod": "tsx scripts/migrate-prod.ts",
    "seed:dev": "tsx scripts/seed-dev-users.ts"
  },
  "dependencies": {
    "@fastify/cors": "8.5.0",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@supabase/supabase-js": "2.43.4",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "4.27.0",
    "jose": "6.2.3",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "6.9.16",
    "postgres": "3.4.9",
    "zod": "3.23.8",
    "@rapa-go/shared": "2.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.14.2",
    "@types/nodemailer": "6.4.17",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
