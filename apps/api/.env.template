# RAPA GO — API Environment Variables (template)
# Copia a .env y completa los valores. Nunca commitear .env con valores reales.

# Base de datos
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-256-bits

# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS — dominio del frontend, sin trailing slash. Múltiples separados por coma.
CORS_ORIGIN=https://your-app-domain.com

# Rate limiting
RATE_LIMIT_MAX=100

# Opcional: proveedor de pagos (cuando se integre)
# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=
