# RAPA GO — API Environment Variables (plantilla segura)
# Copia a .env y completa los valores. Nunca commitear .env con valores reales.

DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
JWT_SECRET=REEMPLAZAR_CON_SECRETO_DE_AL_MENOS_32_CARACTERES
BANK_ACCOUNT_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEX

PORT=3000
HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=1
CORS_ORIGIN=https://your-app-domain.com
FRONTEND_URL=https://your-app-domain.com
RATE_LIMIT_MAX=100

GOOGLE_MAPS_API_KEY=REEMPLAZAR
FACEBOOK_APP_ID=REEMPLAZAR
FACEBOOK_APP_SECRET=REEMPLAZAR
FACEBOOK_REDIRECT_URI=https://your-app-domain.com/auth/facebook/callback

# Sign in with Apple (solo backend; nunca exponer la clave privada al frontend).
# Incluye el Bundle ID nativo y, si se usa web, el Services ID, separados por coma.
APPLE_ALLOWED_CLIENT_IDS=cl.rapago.app
APPLE_TEAM_ID=REEMPLAZAR_CON_TEAM_ID
APPLE_KEY_ID=REEMPLAZAR_CON_KEY_ID
# Pega el contenido PKCS#8 .p8 usando \n entre líneas en el panel del servidor.
APPLE_PRIVATE_KEY=REEMPLAZAR_CON_CLAVE_PRIVADA_PKCS8
# 32 bytes aleatorios (64 caracteres hex) para cifrar el refresh token de Apple.
OAUTH_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEX

PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=REEMPLAZAR
MERCADOPAGO_PUBLIC_KEY=REEMPLAZAR
MERCADOPAGO_CLIENT_ID=REEMPLAZAR
MERCADOPAGO_CLIENT_SECRET=REEMPLAZAR
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR
PAYMENT_WEBHOOK_BASE_URL=https://your-api-domain.com/api/payments

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REEMPLAZAR
SMTP_PASSWORD=REEMPLAZAR
SMTP_FROM_NAME=RAPA GO
SMTP_FROM_EMAIL=soporte@example.com
