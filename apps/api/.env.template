# RAPA GO — API Environment Variables (template)
# Copia a .env y completa los valores. Nunca commitear .env con valores reales.

# Base de datos
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-256-bits

# Sign in with Apple — obligatorias si se usa el endpoint POST /api/auth/apple.
# APPLE_ALLOWED_CLIENT_IDS acepta una lista separada por coma; nunca se acepta
# una audiencia fuera de ella. APPLE_PRIVATE_KEY conserva los saltos de línea
# reales (o \n literal) y nunca se commitea.
APPLE_ALLOWED_CLIENT_IDS=cl.rapago.app
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-p8-private-key-pem

# Cifrado del refresh token de Apple antes de guardarlo (AES-256, 64 chars hex).
# Sin esta clave, el sistema falla cerrado y no guarda el token.
OAUTH_TOKEN_ENCRYPTION_KEY=your-64-char-hex-aes-256-key
# Timeout (ms) para el intercambio y revocación de tokens con Apple. Opcional — fallback 8000ms.
APPLE_TOKEN_TIMEOUT_MS=8000

# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS — dominio del frontend, sin trailing slash. Múltiples separados por coma.
CORS_ORIGIN=https://your-app-domain.com

# Rate limiting
RATE_LIMIT_MAX=100

# Opcional: proveedor de pagos (cuando se integre)
# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# Timeout (ms) para llamadas a la API de Mercado Pago. Opcional — fallback 8000ms.
MERCADOPAGO_TIMEOUT_MS=8000
# Timeout (ms) para llamadas a la API de ProntoPaga. Opcional — fallback 8000ms.
PRONTOPAGA_TIMEOUT_MS=8000

# Comprobantes PDF automáticos de viajes y cargos.
RIDE_RECEIPTS_ENABLED=true
RIDE_RECEIPTS_EMAIL_ENABLED=true
RIDE_RECEIPTS_MAP_PROVIDER=google
RIDE_RECEIPTS_BUCKET=ride-receipts
RIDE_RECEIPTS_SUPPORT_EMAIL=soporte@rapago.cl
RIDE_RECEIPTS_SUPPORT_PHONE=+56 9 4796 4171
RIDE_RECEIPTS_RETRY_INTERVAL_MINUTES=5

# Correo automático cuando el administrador habilita al conductor.
DRIVER_APPROVAL_EMAIL_ENABLED=true
