# ============================================================
# RAPA GO — Mobile Environment Variables
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA commites el archivo .env con valores reales.
# Solo variables públicas no sensibles van aquí.
# ============================================================

# Supabase — clave pública (anon key). NO es el service_role_key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps — clave restringida por bundleId/packageName de la app.
VITE_GOOGLE_MAPS_API_KEY=

# URL base del backend API
VITE_API_BASE_URL=

# Ambiente: development | staging | production
VITE_ENV=development
