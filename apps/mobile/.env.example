# ============================================================
# RAPA GO — Mobile Environment Variables
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA commites el archivo .env con valores reales.
# Solo variables públicas no sensibles van aquí.
# El mobile NUNCA se conecta directamente a la DB ni a auth providers.
# ============================================================

# ── API Backend ────────────────────────────────────────────
# Navegador local: /api  (Vite proxy → localhost:3000)
# Android/iOS y producción: usa una URL HTTPS absoluta accesible desde el teléfono.
# Ejemplo: https://api.rapago.cl/api
VITE_API_BASE_URL=/api

# ── Ambiente ───────────────────────────────────────────────
VITE_ENV=development

# ── Google Maps (fases futuras) ────────────────────────────
# Clave pública restringida por bundleId/packageName de la app
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDZvqVcZBGFPbdHYPM4sYZuIvejDm1ZaOc
