# ============================================================
# RAPA GO — Mobile / Web Environment Variables
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA commitees el archivo .env con valores reales.
# Solo variables públicas no sensibles (prefijo VITE_).
# El cliente NUNCA se conecta directamente a la DB ni guarda secretos de pago/OAuth.
# ============================================================

# ── API Backend ────────────────────────────────────────────
# Navegador local: /api (Vite proxy hacia la API local).
# Android/iOS y web staging/prod: URL HTTPS absoluta.
# Staging/prod actual: https://backend.rapago.cl/api
VITE_API_BASE_URL=/api
# Alias opcional:
# VITE_API_URL=

# ── Ambiente ───────────────────────────────────────────────
VITE_ENV=development

# ── Google Maps (navegador) ────────────────────────────────
# Clave pública restringida por HTTP referrer (web) y/o package+SHA (nativo).
# Referrers recomendados: https://app.rapago.cl/* https://staging.rapago.cl/*
# Déjala vacía en el repositorio. Si alguna clave se filtró: rotar en Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# ── Google Sign-In (web) ───────────────────────────────────
# OAuth 2.0 Web Client ID. Orígenes JS en Google Console (externo):
#   https://staging.rapago.cl
#   https://app.rapago.cl
VITE_GOOGLE_WEB_CLIENT_ID=

# ── Funciones futuras (cerradas por defecto) ───────────────
VITE_ALLOW_FUTURE_FEATURES_IN_PRODUCTION=false
VITE_FEATURE_TOURISM=false
VITE_FEATURE_RENTALS=false
VITE_FEATURE_EVENTS=false

# ── Klap (solo flags/URLs públicas de script) ──────────────
# Checkout alojado por redirect_url; webhooks van al BACKEND, no al SPA.
VITE_KLAP_ELEMENTS_ENABLED=false
# Sandbox: https://sandbox.mcdesaqa.cl/pagos/checkout-flex/v1/main.min.js
# Producción: https://klap.cl/pagos/checkout-flex/v1/main.min.js
VITE_KLAP_CHECKOUT_FLEX_SCRIPT_URL=

# ── Sentry (opcional, DSN público) ─────────────────────────
# VITE_SENTRY_DSN=
