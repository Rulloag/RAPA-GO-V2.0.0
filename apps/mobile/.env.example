# ============================================================
# RAPA GO — Mobile Environment Variables
# ============================================================
# Copia este archivo a .env y completa los valores.
# NUNCA commites el archivo .env con valores reales.
# Solo variables públicas no sensibles van aquí.
# El mobile NUNCA se conecta directamente a la DB ni a auth providers.
# ============================================================

# ── API Backend ────────────────────────────────────────────
# Navegador local: /api (Vite proxy hacia la API local).
# Android/iOS y producción: URL HTTPS absoluta accesible desde el teléfono.
# Ejemplo de producción: https://backend.rapago.cl/api
VITE_API_BASE_URL=/api

# ── Ambiente ───────────────────────────────────────────────
VITE_ENV=development

# ── Google Maps ────────────────────────────────────────────
# Clave pública restringida por dominio, packageName y firma SHA.
# Déjala vacía en el repositorio y complétala solamente en el entorno seguro.
VITE_GOOGLE_MAPS_API_KEY=

# ── Funciones futuras (cerradas por defecto) ───────────────
VITE_ALLOW_FUTURE_FEATURES_IN_PRODUCTION=false
VITE_FEATURE_TOURISM=false
VITE_FEATURE_RENTALS=false
VITE_FEATURE_EVENTS=false

# Klap usa checkout alojado por redirect_url. El cliente no carga SDK de pago.
