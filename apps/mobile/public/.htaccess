DirectoryIndex index.html
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Nunca convertir solicitudes de assets en index.html.
    # Si un archivo no existe, debe responder 404 real y no HTML con nombre .js.
    RewriteRule ^assets(?:/|$) - [END]

    # Servir directamente cualquier archivo o carpeta real.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [END]

    # Rutas internas de Ionic/React.
    RewriteRule ^ index.html [END]
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
    AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # app.js y app.css tienen nombres estables; no deben quedar congelados por CDN.
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>

    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
