{
  "name": "@rapa-go/mobile",
  "version": "2.0.0",
  "private": true,
  "description": "RAPA GO — App móvil Ionic React + Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --workspace=@rapa-go/shared",
    "build": "tsc && vite build",
    "prebuild:prod": "npm run build --workspace=@rapa-go/shared",
    "build:prod": "tsc && vite build --mode production",
    "pretypecheck": "npm run build --workspace=@rapa-go/shared",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "preview": "vite preview",
    "verify:release": "node ../../scripts/release/verify-release.mjs",
    "android:sync:prod": "npm run build:prod && npx cap sync android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.3.4",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.4",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/ios": "8.3.4",
    "@capacitor/local-notifications": "8.2.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capawesome/capacitor-apple-sign-in": "0.1.2",
    "@ionic/react": "8.8.6",
    "@ionic/react-router": "8.8.6",
    "@react-google-maps/api": "2.20.8",
    "@sentry/capacitor": "4.0.0",
    "@sentry/react": "10.43.0",
    "ionicons": "7.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.4",
    "@types/google.maps": "3.65.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.4.5",
    "vite": "5.2.12"
  }
}
