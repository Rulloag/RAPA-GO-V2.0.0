# RAPA GO — Mobile / Web Environment Variables (template)
# Solo variables públicas (VITE_ prefix). Sin datos sensibles.
# Claves reales: configurar en el entorno de build/hosting, nunca en Git.

# API (usar UNA de las dos; el cliente acepta ambas)
# Staging: https://backend.rapago.cl/api  (o API staging si existe)
# Production web: https://backend.rapago.cl/api
VITE_API_BASE_URL=https://your-api-domain.example/api
# Alias opcional (mismo valor que VITE_API_BASE_URL si se usa)
# VITE_API_URL=

# Ambiente: development | staging | production
VITE_ENV=development

# Google Maps Embed/JS (clave de navegador). Restrictir por HTTP referrers:
#   https://app.rapago.cl/*
#   https://staging.rapago.cl/*
#   https://api.rapago.cl/*   (host frontend actual hasta cutover)
# Si una clave quedó expuesta en Git: ROTAR en Google Cloud Console (externo).
VITE_GOOGLE_MAPS_API_KEY=REEMPLAZAR_CON_CLAVE_MAPS_RESTRINGIDA_POR_HTTP_REFERRER

# Google Sign-In web (OAuth Web Client ID — público en bundle, no es secret de servidor)
# Configurar Authorized JavaScript origins en Google Cloud (externo):
#   https://staging.rapago.cl
#   https://app.rapago.cl
VITE_GOOGLE_WEB_CLIENT_ID=REEMPLAZAR_CON_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Klap Elements (opcional). Webhooks/secrets viven solo en backend.
VITE_KLAP_ELEMENTS_ENABLED=false
# Sandbox: https://sandbox.mcdesaqa.cl/pagos/checkout-flex/v1/main.min.js
# Producción: https://klap.cl/pagos/checkout-flex/v1/main.min.js
VITE_KLAP_CHECKOUT_FLEX_SCRIPT_URL=

# Feature flags (cerradas por defecto)
VITE_FEATURE_TOURISM=false
VITE_FEATURE_RENTALS=false
VITE_FEATURE_EVENTS=false

# Opcional: Sentry DSN público
# VITE_SENTRY_DSN=
