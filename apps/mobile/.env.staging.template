# RAPA GO — Web Staging Environment
# Copiar a apps/mobile/.env.staging (o inyectar en el host de staging).
# Sin secretos de servidor. Placeholders only.
# Build: npm run build:staging -w @rapa-go/mobile  (Vite mode=staging)

VITE_API_BASE_URL=https://backend.rapago.cl/api
# VITE_API_URL=https://backend.rapago.cl/api
VITE_ENV=staging
# Alias opcional (debe coincidir con VITE_ENV):
# VITE_APP_ENV=staging

# QA: sourcemaps en dist (default ON). Para desactivar: VITE_STAGING_SOURCEMAPS=false
# VITE_STAGING_SOURCEMAPS=true

# Maps — restringir referrer https://staging.rapago.cl/*
VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In — Authorized JavaScript origin: https://staging.rapago.cl
VITE_GOOGLE_WEB_CLIENT_ID=

VITE_KLAP_ELEMENTS_ENABLED=false
VITE_KLAP_CHECKOUT_FLEX_SCRIPT_URL=https://sandbox.mcdesaqa.cl/pagos/checkout-flex/v1/main.min.js
VITE_FEATURE_TOURISM=false
VITE_FEATURE_RENTALS=false
VITE_FEATURE_EVENTS=false
