# RAPA GO — Mobile Production Environment
# Copiar a apps/mobile/.env.production en el entorno de build.
# No incluir secretos privados: las variables VITE_* quedan dentro del bundle.

VITE_API_BASE_URL=https://backend.rapago.cl/api
VITE_ENV=production

# Clave pública restringida por dominio/package/firma. Completar en CI o equipo de release.
VITE_GOOGLE_MAPS_API_KEY=

# Funciones futuras cerradas para la primera publicación.
VITE_ALLOW_FUTURE_FEATURES_IN_PRODUCTION=false
VITE_FEATURE_TOURISM=false
VITE_FEATURE_RENTALS=false
VITE_FEATURE_EVENTS=false
