# RAPA GO — Mobile / Web Production Environment
# Copiar a apps/mobile/.env.production en el entorno de build.
# No incluir secretos privados: las variables VITE_* quedan dentro del bundle.

VITE_API_BASE_URL=https://backend.rapago.cl/api
# VITE_API_URL=https://backend.rapago.cl/api
VITE_ENV=production

# Clave pública restringida por HTTP referrer / package / firma.
# Referrers: https://app.rapago.cl/* https://api.rapago.cl/* (hasta cutover)
VITE_GOOGLE_MAPS_API_KEY=

# Google Sign-In web — Authorized JavaScript origins (externo):
#   https://app.rapago.cl
#   https://api.rapago.cl  (host frontend actual)
VITE_GOOGLE_WEB_CLIENT_ID=

# Apple Pay / Google Pay se pinchan en el checkout alojado de Klap (redirect_url).
# Return URLs y webhooks se configuran en el BACKEND (KLAP_*), no aquí.
VITE_KLAP_ELEMENTS_ENABLED=false
VITE_KLAP_CHECKOUT_FLEX_SCRIPT_URL=https://klap.cl/pagos/checkout-flex/v1/main.min.js
VITE_FEATURE_TOURISM=false
VITE_FEATURE_RENTALS=false
VITE_FEATURE_EVENTS=false
